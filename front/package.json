{
  "name": "front",
  "version": "1.0.0",
  "main": "./electron/main.js",
  "scripts": {
    "start": "vite",
    "dev": "concurrently -k \"BROWSER=none npm start\" \"npm:electron:dev\"",
    "electron:dev": "vite --config vite.config.electron.ts",
    "electron:build:win": "vite build --config vite.config.electron.ts && electron-builder --win",
    "electron:build:mac": "vite build --config vite.config.electron.ts && electron-builder --mac",
    "build": "tsc && vite build --mode production",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "preview": "vite preview",
    "prepare ": "husky install"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@reduxjs/toolkit": "^1.9.5",
    "axios": "^1.3.2",
    "electron-updater": "^6.2.1",
    "hoslink-xxx": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.0.7",
    "react-router-dom": "^6.8.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,tsx,ts}": [
      "eslint"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "12.1.4",
    "@commitlint/config-conventional": "12.1.4",
    "@electron-forge/cli": "^7.4.0",
    "@types/node": "18.11.18",
    "@types/react": "18.0.37",
    "@types/react-dom": "18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react": "^4.0.0",
    "antd": "^5.19.1",
    "commitizen": "4.3.0",
    "commitlint": "17.6.5",
    "commitlint-config-cz": "0.13.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "6.3.0",
    "electron": "22.1.0",
    "electron-builder": "23.6.0",
    "electron-packager": "^17.1.1",
    "electron-reloader": "^1.2.3",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "husky": "8.0.3",
    "lint-staged": "13.2.2",
    "rollup-plugin-visualizer": "^5.9.0",
    "sass": "^1.63.2",
    "typescript": "*",
    "unplugin-auto-import": "^0.16.7",
    "unplugin-auto-import-antd": "^0.0.1",
    "vite": "^4.3.9",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-imp": "^2.4.0",
    "vite-plugin-require-transform": "^1.0.5",
    "vite-plugin-webpackchunkname": "^0.2.4",
    "wait-on": "^7.2.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "build": {
    "appId": "com.electron.chat_app",
    "productName": "uploadTools",
    "asar": true,
    "copyright": "Copyright © 2023 electron",
    "directories": {
      "output": "release/"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:8080"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "版本更新的具体内容"
    }
  }
}